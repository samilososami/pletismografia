  place-items: center;
  font-family: var(--serif);
  font-size: 28px;
  flex: none;
  transition:
    background 0.25s,
    color 0.25s;
}
.calibration-step.is-active .step-number {
  color: var(--paper);
  background: var(--blue);
}
.calibration-step.is-complete .step-number {
  box-shadow: inset 0 0 0 4px var(--paper);
  background: #e5d5bb;
}
.calibration-step h3 {
  font-size: 17px;
  font-weight: 500;
  line-height: 1.4;
  white-space: nowrap;
}
.calibration-step p {
  font-size: 14px;
  line-height: 1.5;
  margin-top: 2px;
}
.calibration-actions {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 24px;
  align-items: center;
  margin-top: auto;
}
.button {
  min-height: 62px;
  border: 1px solid transparent;
  border-radius: 10px;
  padding: 13px 18px;
  font-size: 20px;
  font-weight: 500;
  line-height: 1.3;
  cursor: pointer;
  transition:
    background 0.2s,
    box-shadow 0.2s,
    transform 0.2s;
  white-space: nowrap;
}
.button:not(:disabled):hover {
  transform: translateY(-2px);
  box-shadow: 0 5px 14px #0b438619;
}
.button:not(:disabled):active {
  transform: translateY(0);
}
.button-blue {
  background: var(--blue);
  color: var(--white);
}
.button-blue:not(:disabled):hover {
  background: #073771;
}
.button-white {
  background: var(--paper);
  color: var(--ink);
}
.button-white:not(:disabled):hover {
  background: #fff;
}
.download {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18px;
  font-size: 17px;
  white-space: nowrap;
  text-underline-offset: 3px;
  min-height: 44px;
}
.download:hover {
  text-decoration-thickness: 2px;
}
.calibration-feedback {
  margin: -10px 0 16px;
}
.calibration-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  line-height: 1.4;
  margin-bottom: 6px;
}
.progress-track {
  height: 4px;
  background: #e6d8c7;
  border-radius: 4px;
  overflow: hidden;
}
.progress-track span {
  display: block;
  height: 100%;
  width: 0;
  background: var(--blue);
  transition: width 0.18s linear;
}
.breathing-panel {
  color: var(--paper);
  background: linear-gradient(110deg, #124986, #0c407f);
  border-color: #47709c;
  padding: 14px 30px 16px;
  position: relative;
}
.breathing-panel > h2 {
  font-size: 36px;
  position: relative;
  z-index: 1;
}
.breathing-content {
  display: grid;
  grid-template-columns: 1fr 220px 1.2fr;
  align-items: center;
  gap: 24px;
  margin-top: 8px;
}
.breathing-phases {
  display: flex;
  flex-direction: column;
  gap: 10px;
  list-style: none;
  padding: 0;
  margin: 0;
  font-size: 20px;
  white-space: nowrap;
}
.breathing-phases li {
  display: flex;
  align-items: center;
  gap: 12px;
  transition: opacity 0.3s;
}
.phase-icon {
  border: 1px solid #ffffff65;
  width: 45px;
  height: 45px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  flex: none;
}
.phase-icon .icon {
  width: 34px;
  height: 34px;
  stroke-width: 1.7;
}
.breathing-panel.is-running .breathing-phases li:not(.is-active) {
  opacity: 0.5;
}
.breathing-panel.is-running .breathing-phases li.is-active .phase-icon {
  background: #ffffff15;
  border-color: var(--paper);
}
.breathing-orbit {
  width: 220px;
  height: 220px;
  border: 1px solid #ffffff70;
  border-radius: 50%;
  position: relative;
  margin-top: -31px;
  display: grid;
  place-items: center;
  isolation: isolate;
}
.orbit-inner,
.orbit-dotted {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.orbit-inner {
  inset: 17px;
  border: 2px dotted var(--paper);
}
.orbit-dotted {
  inset: 35px;
  border: 1px solid #ffffffa0;
  transition: transform 0.1s linear;
}
.orbit-hand {
  position: absolute;
  inset: 17px;
  transform: rotate(0deg);
}
.orbit-hand > span {
  position: absolute;
  width: 18px;
  height: 18px;
  top: -9px;
  left: calc(50% - 9px);
  border-radius: 50%;
  background: var(--paper);
}
.breathing-clock {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
  line-height: 1.1;
}
.breathing-clock > span:first-child {
  font-size: 70px;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.breathing-clock > span:last-child {
  font-size: 20px;
}
.breathing-content > .button {
  padding-inline: 15px;
  margin-bottom: 20px;
  width: 216px;
  max-width: 100%;
  justify-self: end;
  font-size: 19px;
}
